# ── Supabase ─────────────────────────────────────────────
# Get from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Twilio ───────────────────────────────────────────────
# Get from: Twilio Console
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_VERIFY_SERVICE_SID=VA...

# ── Resend ───────────────────────────────────────────────
# Get from: resend.com/api-keys
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hi@stoop.house

# ── App ──────────────────────────────────────────────────
# Production uses the canonical www host. Override locally as needed.
NEXT_PUBLIC_APP_URL=https://www.stoop.house

# ── iOS app support ──────────────────────────────────────
# Apple Developer Team ID (App Store Connect → Membership).
# Not a secret, but account-specific. Until it is set,
# /.well-known/apple-app-site-association returns 404 on purpose,
# so universal links stay off rather than pointing at the wrong app.
APPLE_TEAM_ID=

# Optional. Only needed if the Expo project turns on push security
# ("enhanced security for push notifications"). Leave empty otherwise.
# Get from: expo.dev → account settings → access tokens.
EXPO_ACCESS_TOKEN=
